{
  "name": "emad-personal-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/check-profile.mjs && node scripts/build-cv.mjs && node scripts/check-contrast.mjs",
    "build": "astro build",
    "postbuild": "node scripts/check-cv.mjs && node scripts/check-static-output.mjs",
    "preview": "astro preview",
    "start": "node --experimental-sqlite dist/server/entry.mjs",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^9.1.4",
    "astro": "^5.18.2",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "pdfjs-dist": "^4.10.38"
  }
}
