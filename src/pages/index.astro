---
/**
 * src/pages/index.astro
 *
 * Public Home Page (User Story 1, FR-001..FR-005).
 * Prerendered static page displaying Emad's professional profile.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile.mjs';

export const prerender = true;

const profile = loadProfile();
---

<BaseLayout
  title={`${profile.name} — ${profile.headline}`}
  description={profile.bio}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/emad-poursina.jpg" fetchpriority="high" />
  </Fragment>

  <section class="hero-section" aria-labelledby="brand-name">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1 id="brand-name" class="brand-name">{profile.name}</h1>
        <p class="headline">{profile.headline}</p>

        <div class="key-facts">
          <p class="work-auth">{profile.workAuthorization}</p>
          <p class="availability">Availability: <span>{profile.availability}</span></p>
        </div>

        <nav class="primary-links" aria-label="Primary actions">
          <a
            href="https://t.me/emadpoursina"
            class="btn-hero"
            target="_blank"
            rel="noopener noreferrer">Request Service</a
          >
        </nav>
      </div>

      <div class="hero-portrait">
        <img
          src="/images/emad-poursina.jpg"
          alt="Emad Poursina smiling while working at a laptop at his desk"
          width="642"
          height="666"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <div class="home-container">
    <section class="content-section" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      <p class="bio-text">
        <strong>{profile.name}</strong> is a software engineer who helps teams
        <strong>ship reliable production systems</strong> and keep them
        <strong>maintainable after release</strong>. With <strong>more than seven years of Node.js
        experience</strong>, he owns work from <strong>requirements and architecture</strong> through
        <strong>implementation, deployment, and final release</strong>.
      </p>
      <p class="bio-text">
        His experience spans <strong>technical leadership</strong> on web platforms, <strong>custom
        WordPress development</strong>, <strong>full-stack SaaS products</strong> in React and Next.js,
        and <strong>backend plus DevOps</strong> on AI applications. Recent work includes an
        <strong>AI dictation SaaS</strong> (Electron desktop client and Node.js backend) and a
        <strong>React Native iOS app</strong> for a luxury concierge platform. On these projects he
        <strong>improved existing codebases</strong>, <strong>introduced clearer structure</strong>, and
        <strong>managed releases</strong> to reduce risk for users.
      </p>
      <p class="bio-text">
        He currently focuses on <strong>AI and agentic systems</strong>. He chooses the approach that
        matches the problem: <strong>deterministic code</strong> for reliability, <strong>targeted
        automation</strong> for repetitive tasks, or <strong>agents</strong> when they provide a clear
        benefit. The aim is always a solution that <strong>meets the real need</strong> without adding
        unnecessary complexity or long-term maintenance cost.
      </p>
      <p class="bio-text">
        Teams gain an engineer who can <strong>join at any stage</strong>, <strong>assess existing
        constraints</strong>, and <strong>move the project forward</strong> with practical decisions. He
        works effectively in <strong>remote environments</strong>, delivers <strong>clear code
        reviews</strong>, and treats <strong>release quality</strong> as a core part of the engineering
        process.
      </p>
      <p class="bio-text">
        Organizations that need someone to <strong>own problems end to end</strong> and <strong>apply AI
        only when it improves results</strong> will find that approach in his work.
      </p>
    </section>

    <section class="content-section" aria-labelledby="roles-heading">
      <h2 id="roles-heading">Target Roles</h2>
      <ul class="tag-list">
        {profile.targetRoles.map((role) => (
          <li>{role}</li>
        ))}
      </ul>
    </section>

    <section class="content-section" aria-labelledby="countries-heading">
      <h2 id="countries-heading">Target Countries</h2>
      <ul class="tag-list">
        {profile.targetCountries.map((country) => (
          <li>{country}</li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .home-container {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hero-section {
    position: relative;
    /* Cancel <main> top padding so the banner sits flush under the header */
    margin-top: calc(-1 * var(--space-lg));
    margin-bottom: var(--space-lg);
    color: var(--hero-fg);
    background-color: var(--hero-bg);
    background-image:
      linear-gradient(
        135deg,
        rgba(18, 40, 30, 0.95) 0%,
        rgba(18, 40, 30, 0.86) 55%,
        rgba(18, 40, 30, 0.62) 100%
      ),
      radial-gradient(circle at 82% 45%, rgba(121, 185, 154, 0.28), transparent 55%),
      url("/images/hero-code.svg");
    background-size:
      auto,
      auto,
      320px 320px;
    background-position:
      center,
      center,
      left top;
    background-repeat: no-repeat, no-repeat, repeat;
  }

  .hero-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    min-height: 24rem;
    padding: 3.236rem 1rem;
    display: grid;
    /* Golden split: copy : portrait = phi^2 : 1 */
    grid-template-columns: minmax(0, 1.618fr) minmax(0, 0.618fr);
    align-items: center;
    gap: var(--space-lg);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-portrait {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .hero-portrait img {
    display: block;
    width: 100%;
    height: auto;
    /* Portrait module: 15.618rem (~250px) on the banner */
    max-width: 15.618rem;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 22%;
    border: 0.236rem solid rgba(220, 235, 224, 0.85);
    border-radius: 50%;
    box-shadow: 0 1.618rem 2.618rem rgba(0, 0, 0, 0.35);
  }

  .brand-name {
    /* Display headline on the banner, reference-scale */
    font-size: clamp(2.618rem, 1.618rem + 2.8vw, 3.618rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--hero-fg-strong);
    margin-top: 0;
    margin-bottom: var(--space-sm);
  }

  .headline {
    font-size: 1.125rem;
    font-weight: 400;
    line-height: var(--golden-line);
    color: var(--hero-fg);
    margin-top: 0;
    margin-bottom: var(--space-md);
    max-width: 54ch;
  }

  .key-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.382rem var(--space-md);
    background-color: transparent;
    padding: 0;
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .key-facts p {
    margin: 0;
  }

  .work-auth {
    font-weight: 600;
    color: var(--hero-fg);
  }

  .availability {
    color: var(--hero-fg-muted);
  }

  .availability span {
    color: var(--hero-fg);
    font-weight: 500;
  }

  .primary-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: 0;
  }

  .btn-hero {
    display: inline-block;
    padding: 0.809rem 1.618rem;
    border: 1px solid var(--hero-btn-bg);
    border-radius: 0.146rem;
    background-color: var(--hero-btn-bg);
    color: var(--hero-btn-fg);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.236;
    text-decoration: none;
    text-align: center;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }

  .btn-hero:hover {
    background-color: var(--hero-btn-bg-hover);
    border-color: var(--hero-btn-bg-hover);
    color: var(--hero-btn-fg-hover);
    text-decoration: none;
  }

  .hero-section :focus-visible {
    outline: 2px solid var(--hero-fg-strong);
    outline-offset: 3px;
  }

  .content-section {
    margin-bottom: var(--space-lg);
  }

  .content-section h2 {
    font-size: var(--text-h2);
    margin-top: 0;
    margin-bottom: var(--space-sm);
    border-bottom: 1px solid var(--bg-muted);
    padding-bottom: var(--space-xs);
  }

  .bio-text {
    font-size: var(--text-body);
    line-height: var(--golden-line);
    color: var(--fg);
    margin-top: 0;
    margin-bottom: var(--space-sm);
  }

  .bio-text:last-child {
    margin-bottom: 0;
  }

  .bio-text strong {
    color: var(--fg-heading);
    font-weight: 700;
  }

  .tag-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .tag-list li {
    background-color: var(--bg-muted);
    color: var(--fg);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--space-2xs);
    font-size: var(--text-body);
  }

  @media (max-width: 900px) {
    .hero-inner {
      min-height: 21rem;
      padding: 2.618rem 1rem;
      gap: var(--space-md);
    }

    .hero-portrait img {
      max-width: 12.236rem;
    }
  }

  @media (max-width: 767px) {
    .hero-inner {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 2rem 1rem;
      gap: var(--space-md);
    }

    .hero-portrait {
      order: -1;
      justify-content: flex-start;
    }

    .hero-portrait img {
      max-width: 9rem;
    }

    .headline {
      font-size: 1rem;
    }

    .brand-name {
      font-size: 2.618rem;
    }
  }
</style>
