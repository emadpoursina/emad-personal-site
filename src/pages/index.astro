---
/**
 * src/pages/index.astro
 *
 * Public Home Page (User Story 1, FR-001..FR-005).
 * Prerendered static page displaying Emad's professional profile.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile.mjs';

export const prerender = true;

const profile = loadProfile();
---

<BaseLayout
  title={`${profile.name} — ${profile.headline}`}
  description={profile.bio}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/emad-poursina.jpg" fetchpriority="high" />
  </Fragment>

  <div class="home-container">
    <section class="hero-section" aria-labelledby="headline">
      <div class="hero-copy">
        <h1 id="headline" class="headline">{profile.headline}</h1>
        <p class="author-name">{profile.name}</p>

        <div class="key-facts">
          <p class="work-auth">{profile.workAuthorization}</p>
          <p class="availability">Availability: <span>{profile.availability}</span></p>
        </div>

        <nav class="primary-links" aria-label="Primary actions">
          <a href="/case-studies" class="btn btn-primary">Case Studies</a>
          <a href="/cv.pdf" class="btn btn-secondary">CV</a>
          <a href="/contact" class="btn btn-secondary">Contact</a>
        </nav>
      </div>

      <div class="hero-portrait">
        <img
          src="/images/emad-poursina.jpg"
          alt="Emad Poursina smiling while working at a laptop at his desk"
          width="642"
          height="666"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </section>

    <section class="content-section" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      <p class="bio-text">{profile.bio}</p>
    </section>

    <section class="content-section" aria-labelledby="roles-heading">
      <h2 id="roles-heading">Target Roles</h2>
      <ul class="tag-list">
        {profile.targetRoles.map((role) => (
          <li>{role}</li>
        ))}
      </ul>
    </section>

    <section class="content-section" aria-labelledby="countries-heading">
      <h2 id="countries-heading">Target Countries</h2>
      <ul class="tag-list">
        {profile.targetCountries.map((country) => (
          <li>{country}</li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .home-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hero-section {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    align-items: center;
    gap: 2rem;
    padding: 2.25rem 2rem;
    margin-bottom: 2.5rem;
    border-radius: 14px;
    overflow: hidden;
    background-color: var(--bg-muted);
    background-image: url("/images/hero-code.svg");
    background-size: 320px 320px;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-portrait {
    display: flex;
    justify-content: center;
  }

  .hero-portrait img {
    display: block;
    width: 240px;
    height: 240px;
    object-fit: cover;
    object-position: 50% 22%;
    border: 5px solid var(--bg);
    border-radius: 50%;
    box-shadow:
      0 0 0 3px var(--fg-link),
      0 18px 32px rgba(18, 40, 30, 0.18);
  }

  .headline {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--fg-heading);
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .author-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--fg-muted);
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .key-facts {
    background-color: var(--bg);
    padding: 1rem 1.25rem;
    border-radius: 6px;
    margin-bottom: 1.5rem;
  }

  .key-facts p {
    margin: 0.25rem 0;
  }

  .work-auth {
    font-weight: 600;
    color: var(--fg);
  }

  .availability {
    color: var(--fg-muted);
  }

  .availability span {
    color: var(--fg);
    font-weight: 500;
  }

  .primary-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.625rem 1.25rem;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    border-radius: 4px;
    text-align: center;
  }

  .btn-primary {
    background-color: var(--bg-btn);
    color: var(--fg-btn);
  }

  .btn-primary:hover {
    background-color: var(--bg-btn-hover);
    color: var(--fg-btn-hover);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--fg-link);
    border: 1px solid var(--fg-link);
  }

  .btn-secondary:hover {
    background-color: var(--bg-muted);
    color: var(--fg-link-hover);
    border-color: var(--fg-link-hover);
  }

  .content-section {
    margin-bottom: 2.5rem;
  }

  .content-section h2 {
    font-size: 1.5rem;
    margin-top: 0;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--bg-muted);
    padding-bottom: 0.5rem;
  }

  .bio-text {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--fg);
  }

  .tag-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-list li {
    background-color: var(--bg-muted);
    color: var(--fg);
    padding: 0.375rem 0.75rem;
    border-radius: 4px;
    font-size: 0.9375rem;
  }

  @media (max-width: 767px) {
    .hero-section {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.5rem 1.25rem;
    }

    .hero-portrait {
      order: -1;
    }

    .hero-portrait img {
      width: 180px;
      height: 180px;
    }

    .headline {
      font-size: 1.75rem;
    }
  }
</style>
