---
/**
 * src/pages/case-studies/index.astro
 *
 * Case studies index page listing all published studies.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import studiesDoc from '../../../content/case-studies.json';
import { publishedStudies } from '../../lib/case-studies.mjs';

export const prerender = true;

const studies = publishedStudies(studiesDoc);
---

<BaseLayout
  title="Case Studies — Emad Poursina"
  description="Case studies by Emad Poursina."
>
  <div class="case-studies-container">
    <h1>Case Studies</h1>
    {studies.length === 0 ? (
      <p class="empty-state">No case studies are published yet.</p>
    ) : (
      studies.map((study) => <CaseStudyCard study={study} />)
    )}
  </div>
</BaseLayout>

<style>
  .case-studies-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--fg-heading);
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .empty-state {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--fg-muted);
  }
</style>
