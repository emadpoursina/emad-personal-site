---
/**
 * src/pages/ask.astro
 *
 * Prerendered static Ask page.
 * Uses BaseLayout, displays a single <h1>, a short introduction,
 * and the client-side AskPanel island.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import AskPanel from '../components/AskPanel.astro';

export const prerender = true;
---

<BaseLayout
  title="Ask — Emad Poursina"
  description="Ask questions about Emad Poursina's background, skills, and experience."
>
  <div class="ask-container">
    <h1>Ask about Emad</h1>
    <p class="intro">
      The assistant answers questions using only the approved profile and case studies.
    </p>

    <AskPanel />
  </div>
</BaseLayout>

<style>
  .ask-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--fg-heading);
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .intro {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--fg);
    margin-bottom: 2rem;
  }
</style>
