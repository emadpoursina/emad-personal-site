---
/**
 * src/components/AskPanel.astro
 *
 * Interactive AI assistant panel.
 * - Form with question textarea (maxlength 1000) and submit button.
 * - Live region for status announcements.
 * - Answer container (text only, never HTML).
 * - Sources container for internal citation links.
 * - Static disclaimer paragraph and noscript fallback.
 * - Exactly one Astro-processed client module script.
 */
---

<div class="ask-panel">
  <noscript>
    <p class="ask-noscript">
      JavaScript is required for the assistant. Please use the <a href="/contact">contact form</a> instead.
    </p>
  </noscript>

  <form id="ask-form" class="ask-form" novalidate={false}>
    <div class="form-group">
      <label for="ask-question">Your question</label>
      <textarea
        id="ask-question"
        name="question"
        rows="5"
        maxlength="1000"
        required
        aria-describedby="ask-question-hint"
      ></textarea>
      <p id="ask-question-hint" class="ask-hint">Up to 1,000 characters.</p>
    </div>

    <div class="form-actions">
      <button type="submit" id="ask-submit">Ask</button>
    </div>
  </form>

  <p id="ask-status" role="status" aria-live="polite" class="ask-status"></p>

  <div id="ask-answer" class="ask-answer" hidden></div>

  <ul id="ask-sources" class="ask-sources" hidden aria-label="Sources"></ul>

  <p class="ask-disclaimer">AI assistant. The CV and case studies are the source of record.</p>
</div>

<script>
  const form = document.getElementById('ask-form');
  const questionInput = document.getElementById('ask-question');
  const submitBtn = document.getElementById('ask-submit');
  const statusEl = document.getElementById('ask-status');
  const answerContainer = document.getElementById('ask-answer');
  const sourcesContainer = document.getElementById('ask-sources');

  if (
    form instanceof HTMLFormElement &&
    questionInput instanceof HTMLTextAreaElement &&
    submitBtn instanceof HTMLButtonElement &&
    statusEl instanceof HTMLElement &&
    answerContainer instanceof HTMLElement &&
    sourcesContainer instanceof HTMLElement
  ) {
    const COULD_NOT_ANSWER =
      'The assistant could not answer right now. Please try again later or use the contact form.';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const question = questionInput.value.trim();
      if (!question) {
        statusEl.textContent = 'Please enter a question.';
        return;
      }

      answerContainer.textContent = '';
      sourcesContainer.textContent = '';
      answerContainer.hidden = true;
      sourcesContainer.hidden = true;
      statusEl.textContent = 'Thinking…';
      submitBtn.disabled = true;

      try {
        const response = await fetch('/api/ask', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({ question }),
        });

        let data = null;
        try {
          data = await response.json();
        } catch {
          data = null;
        }

        if (response.status === 200 && data && typeof data.answer === 'string') {
          answerContainer.textContent = data.answer;
          answerContainer.hidden = false;
          statusEl.textContent = '';

          let renderedCount = 0;
          if (Array.isArray(data.sources)) {
            for (const source of data.sources) {
              if (
                source &&
                typeof source.href === 'string' &&
                source.href.startsWith('/')
              ) {
                const li = document.createElement('li');
                const a = document.createElement('a');
                a.textContent =
                  typeof source.label === 'string' ? source.label : source.href;
                a.href = source.href;
                li.appendChild(a);
                sourcesContainer.appendChild(li);
                renderedCount++;
              }
            }
          }

          if (renderedCount > 0) {
            sourcesContainer.hidden = false;
          }
        } else {
          let message = COULD_NOT_ANSWER;
          if (response.status === 400) {
            message =
              data && typeof data.message === 'string'
                ? data.message
                : 'Please check your question and try again.';
          } else if (response.status === 415) {
            message = COULD_NOT_ANSWER;
          } else if (response.status === 429) {
            if (data && data.error === 'daily_cap') {
              message =
                typeof data.message === 'string' && data.message.length > 0
                  ? data.message
                  : 'The assistant is paused for today. Please try again tomorrow or use the contact form.';
            } else if (
              data &&
              Number.isInteger(data.retryAfterSeconds) &&
              data.retryAfterSeconds >= 1
            ) {
              message =
                'Too many questions from this address. Please try again in ' +
                data.retryAfterSeconds +
                ' seconds.';
            } else {
              message =
                data && typeof data.message === 'string' && data.message.length > 0
                  ? data.message
                  : 'Too many questions from this address. Please try again later.';
            }
          } else if (response.status === 503) {
            message = 'The assistant is unavailable right now';
          } else {
            message = COULD_NOT_ANSWER;
          }

          statusEl.textContent = message;
        }
      } catch {
        statusEl.textContent = COULD_NOT_ANSWER;
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .ask-panel {
    max-width: 600px;
  }

  .ask-noscript {
    margin-bottom: 1.25rem;
    padding: 0.75rem 1rem;
    background-color: var(--bg-muted);
    border-radius: 4px;
    color: var(--fg);
  }

  .ask-noscript a {
    color: var(--fg-link);
  }

  .ask-noscript a:hover {
    color: var(--fg-link-hover);
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.375rem;
    font-weight: 600;
    color: var(--fg);
  }

  .form-group textarea {
    display: block;
    width: 100%;
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: 1rem;
    color: var(--fg);
    background-color: var(--bg-form);
    border: 1px solid var(--fg-muted);
    border-radius: 4px;
    box-sizing: border-box;
    resize: vertical;
  }

  .form-group textarea:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .ask-hint {
    margin-top: 0.375rem;
    margin-bottom: 0;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .form-actions {
    margin-top: 1.25rem;
  }

  .form-actions button {
    display: inline-block;
    padding: 0.625rem 1.5rem;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: var(--fg-btn);
    background-color: var(--bg-btn);
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }

  .form-actions button:hover:not(:disabled) {
    background-color: var(--bg-btn-hover);
    color: var(--fg-btn-hover);
  }

  .form-actions button:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .form-actions button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ask-status {
    margin-top: 1.25rem;
    margin-bottom: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--fg);
  }

  .ask-status:empty {
    margin-top: 0;
  }

  .ask-answer {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background-color: var(--bg-muted);
    border-radius: 4px;
    color: var(--fg);
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .ask-sources {
    margin-top: 1rem;
    margin-bottom: 0;
    padding-left: 1.5rem;
    color: var(--fg);
  }

  .ask-sources li {
    margin-bottom: 0.375rem;
  }

  .ask-sources a {
    color: var(--fg-link);
  }

  .ask-sources a:hover {
    color: var(--fg-link-hover);
  }

  .ask-disclaimer {
    margin-top: 1.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }
</style>
