---
/**
 * src/components/ContactForm.astro
 *
 * Native, no-JavaScript contact form.
 * - Submits via POST to /api/contact using standard urlencoded encoding.
 * - Accessible labels for name, email, and message.
 * - Includes direct email fallback with mailto: link.
 */
---

<div class="contact-form-container">
  <form action="/api/contact" method="post" class="contact-form">
    <div class="form-group">
      <label for="name">Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        maxlength="200"
        autocomplete="name"
      />
    </div>

    <div class="form-group">
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        maxlength="320"
        autocomplete="email"
      />
    </div>

    <div class="form-group">
      <label for="message">Message</label>
      <textarea
        id="message"
        name="message"
        required
        maxlength="5000"
        rows="8"
      ></textarea>
    </div>

    <div class="form-actions">
      <button type="submit">Send message</button>
    </div>
  </form>

  <p class="direct-email-fallback">
    Alternatively, write directly to <a href="mailto:emad.poursina.work@gmail.com">emad.poursina.work@gmail.com</a>.
  </p>
</div>

<style>
  .contact-form-container {
    max-width: 600px;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.375rem;
    font-weight: 600;
    color: var(--fg);
  }

  .form-group input,
  .form-group textarea {
    display: block;
    width: 100%;
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: 1rem;
    color: var(--fg);
    background-color: var(--bg-form);
    border: 1px solid var(--fg-muted);
    border-radius: 4px;
    box-sizing: border-box;
  }

  .form-group input:focus-visible,
  .form-group textarea:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .form-actions {
    margin-top: 1.5rem;
  }

  .form-actions button {
    display: inline-block;
    padding: 0.625rem 1.5rem;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: var(--fg-btn);
    background-color: var(--bg-btn);
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }

  .form-actions button:hover {
    background-color: var(--bg-btn-hover);
    color: var(--fg-btn-hover);
  }

  .form-actions button:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .direct-email-fallback {
    margin-top: 1.5rem;
    color: var(--fg-muted);
  }

  .direct-email-fallback a {
    color: var(--fg-link);
  }

  .direct-email-fallback a:hover {
    color: var(--fg-link-hover);
  }
</style>
