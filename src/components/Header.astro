---
/**
 * src/components/Header.astro
 *
 * Site header with site owner name linking to / and primary nav links.
 * Landmarks: <header> containing a native <nav> with an accessible label.
 * No client-side scripts.
 */

import { loadProfile } from '../lib/profile.mjs';

const profile = loadProfile();
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-title">{profile.name}</a>
    <nav class="site-nav" aria-label="Main navigation">
      <ul class="nav-list">
        <li><a href="/cv.pdf" class="nav-link">CV</a></li>
        <li><a href="/contact" class="nav-link">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--bg-muted);
    background-color: var(--bg);
  }

  .header-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .site-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--fg-heading);
    text-decoration: none;
  }

  .site-title:hover {
    color: var(--fg-link-hover);
    text-decoration: underline;
  }

  .site-nav {
    display: flex;
  }

  .nav-list {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--fg-link);
    text-decoration: none;
    font-weight: 500;
  }

  .nav-link:hover {
    color: var(--fg-link-hover);
    text-decoration: underline;
  }
</style>
