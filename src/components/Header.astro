---
/**
 * src/components/Header.astro
 *
 * Site header with a centered owner name (brand) linking to /
 * and primary nav links.
 * Landmarks: <header> containing a native <nav> with an accessible label.
 * - Dark full-bleed banner with an inner band matching the page measure.
 * - Left: primary nav text links. Center: brand. Right: CV + outlined CTA.
 * - The current page is marked with aria-current="page".
 * No client-side scripts.
 */

import { loadProfile } from '../lib/profile.mjs';

const profile = loadProfile();
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="header-inner">
    <nav class="site-nav" aria-label="Main navigation">
      <ul class="nav-list">
        <li>
          <a
            href="/about"
            class="nav-link"
            aria-current={isActive('/about') ? 'page' : undefined}>About</a
          >
        </li>
        <li>
          <a
            href="/case-studies"
            class="nav-link"
            aria-current={isActive('/case-studies') ? 'page' : undefined}>Case Studies</a
          >
        </li>
        <li>
          <a
            href="/cover-letter"
            class="nav-link"
            aria-current={isActive('/cover-letter') ? 'page' : undefined}>Cover Letter</a
          >
        </li>
        <li>
          <a
            href="/ask"
            class="nav-link"
            aria-current={isActive('/ask') ? 'page' : undefined}>Ask</a
          >
        </li>
      </ul>
    </nav>

    <a href="/" class="site-title">{profile.name}</a>

    <div class="header-actions">
      <a href="/cv.pdf" class="header-link" aria-current={currentPath === '/cv.pdf' ? 'page' : undefined}>CV</a>
      <a href="/contact" class="header-cta">Get in Touch</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    padding: 0;
    border-bottom: 1px solid var(--header-border);
    background-color: var(--header-bg);
    color: var(--header-fg);
  }

  .header-inner {
    /* Page measure matches every container: 61.8rem */
    max-width: var(--content-width);
    /* Fixed dark band: phi^3 (4.236rem ~= 68px) on every page */
    min-height: 4.236rem;
    margin: 0 auto;
    padding: 0.618rem 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-sm);
  }

  .site-nav {
    display: flex;
    min-width: 0;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.382rem var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-block;
    padding: 0.382rem 0;
    border-bottom: 2px solid transparent;
    color: var(--header-fg);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.236;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .nav-link:hover {
    color: var(--header-fg-hover);
    border-bottom-color: var(--header-cta-border);
    text-decoration: none;
  }

  .nav-link[aria-current="page"] {
    color: var(--header-fg-strong);
    border-bottom-color: var(--header-fg-strong);
    font-weight: 600;
  }

  .site-title {
    justify-self: center;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.236;
    color: var(--header-fg-strong);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-title:hover {
    color: var(--header-fg-hover);
    text-decoration: underline;
  }

  .header-actions {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: var(--space-sm);
  }

  .header-link {
    color: var(--header-fg);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-link:hover {
    color: var(--header-fg-hover);
    text-decoration: underline;
  }

  .header-cta {
    display: inline-block;
    padding: 0.382rem 0.809rem;
    border: 1px solid var(--header-cta-border);
    border-radius: 0.146rem;
    color: var(--header-cta-fg);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.236;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }

  .header-cta:hover {
    background-color: var(--header-cta-bg-hover);
    border-color: var(--header-cta-bg-hover);
    color: var(--header-cta-fg-hover);
    text-decoration: none;
  }

  .site-header :focus-visible {
    outline: 2px solid var(--header-fg-strong);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .header-inner {
      gap: var(--space-xs);
    }

    .nav-list {
      gap: 0.382rem var(--space-sm);
    }

    .nav-link,
    .header-link {
      font-size: 0.875rem;
    }
  }

  @media (max-width: 767px) {
    .header-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.382rem;
      padding: 0.618rem 1rem;
    }

    .site-title {
      order: -1;
    }

    .site-nav,
    .header-actions {
      justify-self: center;
    }

    .nav-list {
      justify-content: center;
      gap: 0.236rem var(--space-sm);
    }

    .nav-link {
      padding: 0.236rem 0;
    }
  }
</style>
