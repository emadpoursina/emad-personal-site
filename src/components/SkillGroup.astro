---
/**
 * src/components/SkillGroup.astro
 *
 * Renders a single skill category and its skills list.
 */

import { displayLevel } from '../lib/skills.mjs';

interface SkillEntry {
  name: string;
  level: string;
  category?: string;
}

interface Props {
  category: string;
  skills: SkillEntry[];
}

const { category, skills } = Astro.props;
---

<div class="skill-group">
  <h3>{category}</h3>
  <ul class="skill-list">
    {skills.map((skill) => (
      <li class="skill-item">
        <span class="skill-name">{skill.name}</span>
        <span class="skill-level">{displayLevel(skill.level)}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .skill-group {
    margin-bottom: 1.5rem;
  }

  .skill-group h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--fg-heading);
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-item {
    background-color: var(--bg-muted);
    padding: 0.25rem 0.625rem;
    border-radius: 4px;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .skill-name {
    color: var(--fg);
    font-weight: 500;
  }

  .skill-level {
    color: var(--fg-muted);
    font-size: 0.8125rem;
  }
</style>
