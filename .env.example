# TCP port Astro listens on (default: 4321)
PORT=
# Bind address (default: 0.0.0.0)
HOST=
# Directory for site.sqlite (default: ./data)
DATA_DIR=
# Email address that receives contact messages (default: emad.poursina.work@gmail.com)
CONTACT_TO=
# Max contact form submissions per IP per hour (default: 5)
CONTACT_RATE_LIMIT_PER_HOUR=
# Number of trusted proxy hops for X-Forwarded-For (default: 0)
TRUST_PROXY=
# SMTP server hostname
SMTP_HOST=
# SMTP port (default: 587)
SMTP_PORT=
# Use TLS from the start (default: false; true for port 465)
SMTP_SECURE=
# SMTP login username
SMTP_USER=
# SMTP login password
SMTP_PASS=
# From address in sent emails (default: Emad Poursina <emad.poursina.work@gmail.com>)
SMTP_FROM=
# Admin authentication password hash (scrypt)
ADMIN_PASSWORD_HASH=
# 32-byte secret encryption key (base64 or 64 hex characters)
ENCRYPTION_KEY=
# AI provider API base URL (default: https://openrouter.ai/api/v1)
AI_BASE_URL=
# AI model identifier (default: anthropic/claude-haiku-5.5)
AI_MODEL=
# AI provider API key
AI_API_KEY=
# Maximum assistant queries globally per UTC day (default: 200)
ASK_DAILY_CAP=
# Maximum assistant queries per IP per hour (default: 10)
ASK_RATE_LIMIT_PER_HOUR=
# AI provider request timeout in milliseconds (default: 30000, max: 30000)
AI_TIMEOUT_MS=
